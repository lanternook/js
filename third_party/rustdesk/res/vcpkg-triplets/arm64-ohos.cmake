set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_MAKE_BUILD_TRIPLET "--host=aarch64-linux")
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../../../../scripts/ohos-vcpkg-toolchain.cmake")
if(NOT DEFINED OHOS_NATIVE_SDK OR "${OHOS_NATIVE_SDK}" STREQUAL "")
  set(OHOS_NATIVE_SDK "$ENV{OHOS_NATIVE_SDK}")
endif()
set(OHOS_SYSROOT "${OHOS_NATIVE_SDK}/sysroot")
set(VCPKG_C_FLAGS "--target=aarch64-linux-ohos --sysroot=${OHOS_SYSROOT} -D__MUSL__")
set(VCPKG_CXX_FLAGS "--target=aarch64-linux-ohos --sysroot=${OHOS_SYSROOT} -D__MUSL__")
set(VCPKG_LINKER_FLAGS "--target=aarch64-linux-ohos --sysroot=${OHOS_SYSROOT}")
